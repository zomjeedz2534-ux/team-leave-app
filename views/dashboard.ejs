<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>ระบบลาพักร้อนของทีม</title>
<link rel="stylesheet" href="/css/style.css" />
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
</head>
<body>
<div class="app-shell">
  <header class="topbar">
    <div class="brand">🌴 ระบบลาของทีม</div>
    <nav class="tabs" id="tabs">
      <button class="tab-btn active" data-tab="calendar">ปฏิทินทีม</button>
      <button class="tab-btn" data-tab="request">ขอลา</button>
      <% if (isElevated) { %>
      <button class="tab-btn" data-tab="pending">อนุมัติคำขอ <span id="pendingBadge" class="badge" style="display:none">0</span></button>
      <% } %>
      <button class="tab-btn" data-tab="balance">วันลาคงเหลือ</button>
      <% if (isElevated) { %>
      <button class="tab-btn" data-tab="team">จัดการทีม</button>
      <% } %>
      <button class="tab-btn" data-tab="history">ประวัติ</button>
      <button class="tab-btn" data-tab="account">บัญชีของฉัน</button>
    </nav>
    <div class="userbox">
      <span><span id="topbarUserName"><%= user.name %></span> <small>(<%= roleLabel %>)</small></span>
      <form method="POST" action="/logout"><button class="btn btn-ghost" type="submit">ออกจากระบบ</button></form>
    </div>
  </header>

  <main class="content">
    <div id="toast" class="toast"></div>

    <!-- ปฏิทินทีม -->
    <section class="panel active" id="panel-calendar">
      <div class="panel-head">
        <h2>ปฏิทินวันลาของทีม</h2>
        <div class="legend" id="legend"></div>
      </div>
      <div id="calendar"></div>
    </section>

    <!-- ขอลา -->
    <section class="panel" id="panel-request">
      <div class="grid-2">
        <div class="card">
          <h2>ยื่นคำขอลา</h2>
          <form id="leaveForm">
            <label>วันที่เริ่ม</label>
            <input type="date" name="startDate" id="startDate" required />
            <label>วันที่สิ้นสุด</label>
            <input type="date" name="endDate" id="endDate" required />
            <label>ประเภทการลา</label>
            <select name="type" id="leaveType" required>
              <% leaveTypes.forEach(t => { %>
                <option value="<%= t.key %>"><%= t.label %></option>
              <% }) %>
            </select>
            <label>เหตุผล</label>
            <textarea name="reason" rows="3" placeholder="ระบุเหตุผลการลา (ไม่บังคับ)"></textarea>
            <label>อีเมลที่ต้องการ tag เพิ่มเติมใน Google Calendar</label>
            <textarea name="extraEmails" rows="2" placeholder="คั่นด้วยจุลภาคหรือขึ้นบรรทัดใหม่ เช่น manager@company.com, hr@company.com (ไม่บังคับ)"></textarea>
            <label id="attachmentLabel">แนบไฟล์ใบรับรองแพทย์ / รูปภาพประกอบ (ถ้ามี)</label>
            <input type="file" id="attachmentInput" accept="image/jpeg,image/png,image/webp,image/heic,application/pdf" />
            <p class="hint" style="margin-top:4px">รองรับ JPG, PNG, WEBP, HEIC, PDF ขนาดไม่เกิน 4MB</p>
            <button type="submit" class="btn btn-primary">ส่งคำขอ</button>
          </form>
        </div>
        <div class="card">
          <h2>คำขอของฉัน</h2>
          <div id="myLeaveList" class="list"></div>
        </div>
      </div>
    </section>

    <% if (isElevated) { %>
    <!-- อนุมัติคำขอ -->
    <section class="panel" id="panel-pending">
      <h2>คำขอที่รออนุมัติ</h2>
      <div id="pendingList" class="list"></div>
    </section>
    <% } %>

    <!-- วันลาคงเหลือ -->
    <section class="panel" id="panel-balance">
      <h2>สรุปวันลาคงเหลือ</h2>
      <div id="balanceTable"></div>
    </section>

    <% if (isElevated) { %>
    <!-- จัดการทีม -->
    <section class="panel" id="panel-team">
      <div class="grid-2">
        <div class="card">
          <h2>เพิ่มสมาชิกทีม</h2>
          <form id="addUserForm">
            <label>ชื่อ</label>
            <input type="text" name="name" required />
            <label>อีเมล</label>
            <input type="email" name="email" required />
            <label>รหัสผ่านเริ่มต้น</label>
            <input type="text" name="password" required minlength="6" />
            <label>บทบาท</label>
            <select name="role">
              <% roles.forEach(r => { %>
                <option value="<%= r.key %>" <%= r.key === 'junior' ? 'selected' : '' %>><%= r.label %></option>
              <% }) %>
            </select>
            <button type="submit" class="btn btn-primary">เพิ่มสมาชิก</button>
          </form>
        </div>
        <div class="card">
          <h2>เชื่อมต่อ Google Calendar</h2>
          <p id="googleStatus" class="muted">กำลังตรวจสอบ...</p>
          <a href="/auth/google" class="btn btn-primary" id="connectGoogleBtn">เชื่อมต่อ Google Calendar</a>
          <button class="btn btn-ghost" id="disconnectGoogleBtn" style="display:none">ยกเลิกการเชื่อมต่อ</button>
          <p class="hint">เมื่ออนุมัติคำขอลา ระบบจะสร้าง event ในปฏิทินนี้และ tag อีเมลผู้ขอลาโดยอัตโนมัติ</p>
        </div>
      </div>

      <div class="card" style="margin-top:20px">
        <h2>สิทธิวันลารายบุคคล</h2>
        <p class="hint" style="margin-top:0">ปรับจำนวนวันลาแต่ละประเภทของแต่ละคนได้ตามจริง เช่น อายุงานมากขึ้น สิทธิ์ก็เพิ่มขึ้น</p>
        <div id="teamQuotaTable" class="table-scroll"></div>
      </div>
    </section>
    <% } %>

    <!-- ประวัติ -->
    <section class="panel" id="panel-history">
      <div class="card" style="margin-bottom:20px">
        <h2>คำขอลาทั้งหมด</h2>
        <p class="hint" style="margin-top:0">
          <% if (isElevated) { %>
            แก้ไขหรือลบคำขอลาของใครก็ได้ (ไม่ว่าจะสถานะไหน) — ถ้าคำขอนั้น sync ขึ้น Google Calendar แล้ว ระบบจะอัปเดต/ลบ event ให้อัตโนมัติด้วย
          <% } else { %>
            ลบคำขอลาของตัวเองได้ (ไม่ว่าจะสถานะไหน) — ถ้าคำขอนั้น sync ขึ้น Google Calendar แล้ว ระบบจะลบ event ให้อัตโนมัติด้วย
          <% } %>
        </p>
        <div id="allLeaveList" class="list"></div>
      </div>
      <% if (isElevated) { %>
      <div class="card">
        <h2>ประวัติการดำเนินการ</h2>
        <div id="historyLog" class="list"></div>
      </div>
      <% } %>
    </section>

    <!-- บัญชีของฉัน -->
    <section class="panel" id="panel-account">
      <div class="card" style="max-width:420px; margin-bottom:20px">
        <h2>แก้ไขข้อมูลส่วนตัว</h2>
        <form id="profileForm">
          <label>ชื่อ</label>
          <input type="text" name="name" id="profileName" required />
          <label>อีเมล</label>
          <input type="email" name="email" id="profileEmail" required />
          <button type="submit" class="btn btn-primary">บันทึก</button>
        </form>
      </div>
      <div class="card" style="max-width:420px">
        <h2>เปลี่ยนรหัสผ่าน</h2>
        <form id="passwordForm">
          <label>รหัสผ่านปัจจุบัน</label>
          <input type="password" name="currentPassword" required />
          <label>รหัสผ่านใหม่</label>
          <input type="password" name="newPassword" required minlength="6" />
          <button type="submit" class="btn btn-primary">บันทึก</button>
        </form>
      </div>
    </section>
  </main>
</div>

<script>
  window.__APP_USER__ = <%- JSON.stringify(user) %>;
  window.__LEAVE_TYPES__ = <%- JSON.stringify(leaveTypes) %>;
  window.__ROLES__ = <%- JSON.stringify(roles) %>;
  window.__IS_ELEVATED__ = <%- JSON.stringify(isElevated) %>;
</script>
<script src="/js/dashboard.js"></script>
</body>
</html>
