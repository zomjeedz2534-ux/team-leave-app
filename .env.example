# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง

# ---- ฐานข้อมูล Postgres (เช่นจาก neon.tech ฟรี) ดูขั้นตอนใน README.md ----
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ใช้เข้ารหัส session cookie ตั้งเป็นข้อความยาวๆ สุ่มอะไรก็ได้
SESSION_SECRET=change-this-to-a-random-long-string

PORT=3300

# ---- บัญชีผู้ดูแลระบบเริ่มต้น (ใช้ตอนรัน "npm run seed" ครั้งแรกเท่านั้น) ----
ADMIN_NAME=ผู้ดูแลระบบ
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ---- Google Calendar OAuth (ดูขั้นตอนสร้างใน README.md) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3300/auth/google/callback
